{
  "characters": [
    {
      "name": "甄士隐",
      "description": "姓甄，名费，字士隐，嫡妻封氏，禀性恬淡，不以功名为念，年已半百，膝下无儿，只有一女英莲"
    },
    {
      "name": "封氏",
      "description": "甄士隐的嫡妻，情性贤淑，深明礼义"
    },
    {
      "name": "英莲",
      "description": "甄士隐之女，乳名，年方三岁，生得粉妆玉琢，乖觉可喜，后来走失"
    },
    {
      "name": "贾雨村",
      "description": "姓贾名化，表字时飞，别号雨村，胡州人氏，诗书仕宦之族，穷儒，寄居葫芦庙，卖字作文为生"
    },
    {
      "name": "霍启",
      "description": "甄士隐家的家人，因看护不当导致英莲走失，后逃往他乡"
    },
    {
      "name": "封肃",
      "description": "甄士隐的岳丈，大如州人氏，务农，家中殷实"
    },
    {
      "name": "甄家丫鬟",
      "description": "甄家的大丫鬟，生得仪容不俗，眉目清明，曾与贾雨村有过眼神交流"
    },
    {
      "name": "僧人",
      "description": "癞头跣脚，与道人同行，具有神通，能施佛法"
    },
    {
      "name": "道人",
      "description": "跛足蓬头，疯疯癫癫，与僧人同行，后来又以跛足道人身份出现"
    },
    {
      "name": "空空道人",
      "description": "访道求仙之人，后改名情僧，将《石头记》抄录传世"
    },
    {
      "name": "曹雪芹",
      "description": "在悼红轩中披阅十载，增删五次，纂成目录，分出章回"
    },
    {
      "name": "神瑛侍者",
      "description": "赤瑕宫神瑛侍者，日以甘露灌溉绛珠草，后下凡造历幻缘"
    },
    {
      "name": "绛珠仙子",
      "description": "原为绛珠草，受神瑛侍者灌溉之恩，后修成女体，欲以眼泪偿还恩情"
    }
