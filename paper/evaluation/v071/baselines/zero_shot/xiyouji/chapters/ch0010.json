{
  "characters": [
    {
      "name": "太宗",
      "description": "大唐皇帝，又称李世民、唐太宗文皇帝，与魏征对弈时因泾河龙王事件而魂游地府"
    },
    {
      "name": "魏征",
      "description": "朝中重臣，梦中斩龙，后守后宰门，手持诛龙宝剑，与崔珪有书信往来"
    },
    {
      "name": "泾河龙王",
      "description": "被魏征梦中所斩的龙，死后向太宗索命，后被观音菩萨喝退"
    },
    {
      "name": "秦叔宝",
      "description": "将军，与徐茂功一同将龙头呈给皇帝，后与尉迟敬德守前宫门"
    },
    {
      "name": "徐茂功",
      "description": "将军，与秦叔宝一同发现龙头，后受太宗托付国家大事"
    },
    {
      "name": "尉迟敬德",
      "description": "护国公，与秦叔宝一同守前宫门"
    },
    {
      "name": "观音菩萨",
      "description": "女真人形象，用杨柳枝喝退龙王，领佛旨到东土寻取经人"
    },
    {
      "name": "崔珪",
      "description": "生前为兹州令后升礼部侍郎，死后在阴司做酆都掌案判官，魏征的八拜之交"
    },
    {
      "name": "李渊",
      "description": "太宗的先父，已故，魂在地府"
    },
    {
      "name": "建成",
      "description": "太宗的先兄，已故，在地府中向太宗索命"
    },
    {
      "name": "元吉",
      "description": "太宗的故弟，已故，在地府中向太宗索命"
    },
    {
      "name": "十代阎王",
      "description": "秦广王、楚江王、宋帝王、仵官王、阎罗王、平等王、泰山王、都市王、卞城王、转轮王，阴间鬼王"
    },
    {
      "name": "朱太尉",
      "description": "阴司官员，执引魂幡，与崔判官一同送太宗还魂"
    },
    {
      "name": "相良",
      "description": "河南开封府人，有十三库金银在阴司寄放"
